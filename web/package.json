{
  "name": "nexusdesk-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --build && vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint .",
    "format": "prettier --write src/ vite.config.ts vitest.config.ts eslint.config.ts",
    "format:check": "prettier --check src/ vite.config.ts vitest.config.ts eslint.config.ts"
  },
  "dependencies": {
    "lossless-json": "4.3.3",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitest/eslint-plugin": "1.6.28",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "jiti": "2.7.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vite": "8.3.7",
    "vitest": "4.1.12",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "playwright": "1.65.0"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
