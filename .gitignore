# 本地环境配置；示例模板可以提交。
.env
.env.*
!.env.example

# 编译产物、测试二进制与性能采样。
/bin/
/build/
/dist/
*.exe
*.test
*.prof
*.pprof

# 覆盖率、日志、缓存和本地数据。
/coverage/
/coverage.out
/coverage.html
/tmp/
/.local/
/.superpowers/
/deploy/pgdata/
/var/storage/
*.log
# 保留经过脱敏、用于交付审查的第一周验证记录。
!/docs/weekly/evidence/*.log
__pycache__/
*.py[cod]

# 编辑器临时文件与系统文件。
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# go.mod、go.sum、迁移和设计文档均应纳入版本管理。

# 脱敏的DeepSeek接入集成验收记录。
!/docs/testing/evidence/deepseek/integration.log

# W08 仅包含合成数据、经过脱敏的实际验收输出。
!/docs/testing/evidence/week08/integration.log
!/docs/testing/evidence/week08/checks.log

# W09 owned synthetic fixture verification only.
!/docs/testing/evidence/week09/integration.log
!/docs/testing/evidence/week09/checks.log

# W11 reviewed synthetic-fixture evidence; private/ad-hoc profiles stay ignored.
!/docs/testing/evidence/week11/integration.log
!/docs/testing/evidence/week11/checks.log
!/docs/testing/evidence/week11/browser.log
!/docs/testing/evidence/week11/performance-*.pprof

# W12 owned synthetic fixture and source-package build evidence only.
!/docs/testing/evidence/week12/integration.log
!/docs/testing/evidence/week12/checks.log
!/docs/testing/evidence/week12/browser.log
!/docs/testing/evidence/week12/demo-browser.log
!/docs/testing/evidence/week12/package-build.log
