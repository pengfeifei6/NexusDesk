# 本地开发示例：复制为 .env 后，由开发者设置实际值。
# 本文件不包含真实凭据；修改后的 .env 不提交到 Git。
# 使用简单的 Bash KEY=VALUE 格式，不在等号两侧添加空格。
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080

# W1：Go API 在宿主机运行，数据库通过本地容器映射端口访问。
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=nexusdesk
DB_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
DB_NAME=nexusdesk

# 仅适用于当前本机开发场景；部署环境需单独配置连接安全。
DB_SSLMODE=disable

# W02 Day 4：JWT 本地配置，真实随机密钥只由开发者本机填写。
JWT_ISSUER=nexusdesk
JWT_AUDIENCE=nexusdesk-api
JWT_TTL_MINUTES=15
JWT_SECRET_BASE64=REPLACE_WITH_LOCAL_BASE64_SECRET

# W05：可选项，未提供时使用下面的默认值；私有目录不得映射为静态文件。
STORAGE_ROOT=./var/storage
UPLOAD_MAX_FILE_BYTES=5242880
UPLOAD_MAX_REQUEST_BYTES=8388608
TEXT_EXTRACT_MAX_BYTES=1048576
TEXT_EXTRACT_TIMEOUT_SECONDS=10

# W06：本地模型，无需外部 API Key；固定模型与 1024 维索引不能单独替换
RAG_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_DIM=1024
CHAT_MODEL=qwen3.5:35b
RAG_MIN_SCORE=0.40

# W07：独立 Worker / Redis；API 不依赖 Redis 启动。Worker 和 API 必须指向相同数据库/私有目录。
ASYNC_ENABLED=true
REDIS_ADDR=127.0.0.1:6380
REDIS_DB=6
REDIS_PASSWORD=
WORKER_CONCURRENCY=2
